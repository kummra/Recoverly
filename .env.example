NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI coach — Groq Cloud (OpenAI-compatible, very fast Qwen inference)
GROQ_API_KEY=
# Optional override (default shown):
# GROQ_MODEL=qwen/qwen3.8-27b

# Server-side Firebase Admin credentials (for API routes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: a heads-up when an organisation sends an enquiry (see src/lib/notify.ts).
# A Slack or Discord incoming-webhook address (https only). It is a secret: anyone with it
# can post to your channel. The message says only that an enquiry of some kind arrived and
# where to read it, never the name, email or message. If unset, nothing is sent.
# ENQUIRY_WEBHOOK_URL=https://hooks.slack.com/services/...

# Oracle Autonomous Database — an optional second copy of app data (server-side only).
# OFF since 2026-11-26: Oracle had terminated the production database (its notice is
# dated 2026-10-26), so the three settings were removed from Vercel. Leave them unset:
# with any one missing, the sync layer does nothing. Before turning a copy back on,
# say in the privacy policy that it exists (the policy does not mention Oracle).
# To connect: thin-mode driver, the 1-way TLS connect string (protocol=tcps) from the
# ADB console, no wallet required.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
